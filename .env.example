# Copy to .env and fill in. Read by the API server (apps/api).

# TMDB: https://www.themoviedb.org/settings/api — use the "API Read Access Token".
TMDB_READ_ACCESS_TOKEN=
# (or the older v3 key instead)
# TMDB_API_KEY=

# Postgres for swipes + the recommender's training data.
# `pnpm db:up` starts one with Docker matching this URL. Leave unset to use an
# in-memory store (fine for trying it out; data is lost on restart).
DATABASE_URL=postgres://movee:movee@localhost:5432/movee

# Optional: Claude writes the "viewer type" label on the Profile tab.
# Without it a rule-based label is used.
# ANTHROPIC_API_KEY=

PORT=8080
