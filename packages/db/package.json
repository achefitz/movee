{
  "name": "@movee/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "users": "tsx ./scripts/users.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "dotenv": "^16.4.7",
    "tsx": "catalog:"
  }
}
