{
  "name": "muse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node ./dev.mjs",
    "dev:api": "pnpm --filter @muse/api run dev",
    "dev:mobile": "pnpm --filter @muse/mobile run dev",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @muse/db run push",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @muse/api run recsys:e2e"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
